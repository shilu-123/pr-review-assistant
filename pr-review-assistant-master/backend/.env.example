# URL of the frontend, used for CORS
FRONTEND_URL=http://localhost:3000

# Get one free at https://aistudio.google.com/apikey (sign in with Google)
GEMINI_API_KEY=your_gemini_api_key

# Optional — defaults to gemini-3.6-flash, currently on the free tier
GEMINI_MODEL=gemini-3.6-flash

# Free Postgres: https://neon.tech or https://supabase.com — create a
# project, copy the connection string, and change "postgresql://" to
# "postgresql+asyncpg://" (drop any "?sslmode=require" suffix — SSL is
# handled by DB_SSL below instead).
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# Most free hosted Postgres requires SSL. Set to false only for a local
# Postgres instance without SSL configured.
DB_SSL=true
